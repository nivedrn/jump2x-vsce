{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2020",
    "outDir": "out",
    "lib": [
      "ES2020"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "nodenext",
    "types": [
      "node",
      "vscode"
    ]
  },
  "include": [
    "src"
  ]
}